{
  "name": "kairo-login",
  "private": true,
  "description": "Privy login island for Kairo, bundled into ../assets/login",
  "scripts": {
    "build": "esbuild login.jsx --bundle --minify --splitting --format=esm --target=es2020 '--define:process.env.NODE_ENV=\"production\"' --define:global=globalThis --outdir=../assets/login --chunk-names=c-[hash]"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.48.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "viem": "^2.57.4",
    "esbuild": "0.28.2"
  }
}

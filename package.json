{
  "name": "surge-terminal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Surge — a live trading terminal for new Uniswap v4 launches on Robinhood Chain. Privy login, non-custodial ETH trading, TP/SL automation.",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@privy-io/react-auth": "^3.48.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "vite": "^6.4.4"
  }
}
